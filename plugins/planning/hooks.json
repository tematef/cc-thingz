{
  "autonomous-exec-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/autonomous-exec-hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "plan-annotate": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 scripts/plan-review-hook.py",
        "timeout": 345600
      }
    ]
  },
  "ralphex-plans-link": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 scripts/ralphex-plans-link-hook.py",
        "timeout": 5
      }
    ]
  }
}
